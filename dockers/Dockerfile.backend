FROM python:3.12-slim

WORKDIR /app

# Set environment variables to prevent Python from writing .pyc files and to ensure that output is not buffered
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Install the runtime dependencies with uv. --no-dev omits the dev group and the
# notebooks group is non-default, so the Jupyter/viz stack is left out.
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/
COPY pyproject.toml uv.lock /app/
RUN uv sync --frozen --no-dev
ENV PATH="/app/.venv/bin:$PATH"

# Copy the application code to the container
COPY src/backend /app/src/backend

# Command to run the application using Uvicorn, specifying the host and port
CMD ["uvicorn", "src.backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
