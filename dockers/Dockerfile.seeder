FROM python:3.12-slim

WORKDIR /app

# Set environment variables to prevent Python from writing .pyc files and to ensure that output is not buffered
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

# Optional seeding parameters, can be provided via build args or runtime env vars.
# These env vars are translated into CLI flags by the CMD shell expansion below
# (they also override config.yaml directly when set to non-empty values).
ARG DATA_START_DATE
ARG DATA_END_DATE
ARG DOWNLOAD_JC
ARG PARALLEL_MONTHS
ARG DB_LOADER_WORKERS
ENV DATA_START_DATE=${DATA_START_DATE} \
    DATA_END_DATE=${DATA_END_DATE} \
    DOWNLOAD_JC=${DOWNLOAD_JC} \
    PARALLEL_MONTHS=${PARALLEL_MONTHS} \
    DB_LOADER_WORKERS=${DB_LOADER_WORKERS}

# Install the runtime dependencies with uv. --no-dev omits the dev group and the
# notebooks group is non-default, so the Jupyter/viz stack is left out.
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/
COPY pyproject.toml uv.lock /app/
RUN uv sync --frozen --no-dev
ENV PATH="/app/.venv/bin:$PATH"

# Copy the application code to the container
COPY src/ingestion /app/src/ingestion
COPY src/backend /app/src/backend
COPY postgres/ /app/postgres/

# Command to run the data download script
CMD ["sh", "-c", "python -m src.ingestion.cli ${DATA_START_DATE:+--start-date $DATA_START_DATE} ${DATA_END_DATE:+--end-date $DATA_END_DATE} ${DOWNLOAD_JC:+--download-jc} ${PARALLEL_MONTHS:+--parallel-months $PARALLEL_MONTHS} ${DB_LOADER_WORKERS:+--db-loader-workers $DB_LOADER_WORKERS}"]
